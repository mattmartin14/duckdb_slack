# name: test/sql/slack.test
# description: test Slack webhook secrets and function binding
# group: [sql]

require slack

statement ok
CREATE TEMP SECRET slack_test (
    TYPE slack,
    WEBHOOK_URL 'https://hooks.slack.com/services/T000/B000/test'
);

query I
SELECT secret_string LIKE '%webhook_url=redacted%'
FROM duckdb_secrets()
WHERE name = 'slack_test';
----
true

statement ok
CREATE TEMP SECRET slack_wrong_type (TYPE http, BEARER_TOKEN 'not-a-real-token');

statement error
CALL slack_post('missing_secret', msg => 'test');
----
Slack secret 'missing_secret' was not found

statement error
CALL slack_post(secret_name => 'missing_secret', msg => 'test');
----
Slack secret 'missing_secret' was not found

statement error
CALL slack_post('slack_wrong_type', msg => 'test');
----
Secret 'slack_wrong_type' is not a Slack secret

statement error
CALL slack_post('slack_test');
----
Binder Error

statement error
CALL slack_post('slack_test', 'test');
----
Binder Error

statement error
CALL slack_post(secret_name => 'slack_test', msg => 'test', color => 'blue');
----
slack_post color must be 'good', 'danger', or 'info'

statement error
CALL slack_post(secret_name => 'slack_test', msg => 'test', title => 'report');
----
slack_post title and fields require color

statement error
CALL slack_post(secret_name => 'slack_test', msg => 'test', fields => MAP {'count': '1'});
----
slack_post title and fields require color

statement error
CALL slack_post(secret_name => 'slack_test', msg => 'test', color => 'good', title => '');
----
slack_post title must not be empty

statement error
CALL slack_post(secret_name => 'slack_test', msg => 'test', color => 'good', fields => MAP {'count': NULL});
----
slack_post fields must have non-empty keys and non-NULL values

statement error
CALL slack_post(secret_name => 'slack_test', msg => 'test', color => 'good', fields => MAP {'': 'value'});
----
slack_post fields must have non-empty keys and non-NULL values

statement ok
SET VARIABLE too_many_fields = (
    SELECT map_from_entries(list(('metric' || i, i::VARCHAR) ORDER BY i))
    FROM range(471) AS data(i)
);

statement error
CALL slack_post(secret_name => 'slack_test', msg => 'test', color => 'good', fields => getvariable('too_many_fields'));
----
slack_post supports at most 470 fields

statement error
CALL slack_post(secret_name => NULL, msg => 'test');
----
slack_post secret_name and msg must not be NULL

statement error
CALL slack_post(secret_name => 'slack_test', msg => NULL);
----
slack_post secret_name and msg must not be NULL

statement error
CALL slack_post('slack_test', secret_name => 'slack_test', msg => 'test');
----
Binder Error
